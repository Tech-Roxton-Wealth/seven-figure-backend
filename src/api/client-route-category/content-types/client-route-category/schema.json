{
  "kind": "collectionType",
  "collectionName": "client_route_categories",
  "info": {
    "singularName": "client-route-category",
    "pluralName": "client-route-categories",
    "displayName": "Client Route Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "client_routes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::client-route.client-route",
      "mappedBy": "client_route_category"
    }
  }
}
