{
  "kind": "collectionType",
  "collectionName": "insights",
  "info": {
    "singularName": "insight",
    "pluralName": "insights",
    "displayName": "Insight"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "publishDate": {
      "type": "date"
    },
    "excerpt": {
      "type": "text"
    },
    "insightLabel": {
      "type": "string"
    },
    "insightDescription": {
      "type": "text"
    },
    "readingTimeMinutes": {
      "type": "integer",
      "min": 1
    },
    "featuredLabel": {
      "type": "string"
    },
    "cardMark": {
      "type": "string"
    },
    "searchKeywords": {
      "type": "text"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "heroCaptionLabel": {
      "type": "string"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "heroImageLabel": {
      "type": "string"
    },
    "heroImageCaption": {
      "type": "string"
    },
    "authorName": {
      "type": "string"
    },
    "authorBio": {
      "type": "text"
    },
    "authorImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "riskDisclaimer": {
      "type": "text"
    },
    "insightCategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::insight-category.insight-category",
      "inversedBy": "insights"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "content": {
      "type": "blocks"
    },
    "tableOfContents": {
      "type": "component",
      "component": "ui.toc-item",
      "repeatable": true
    },
    "relatedInsightsBlock": {
      "type": "component",
      "component": "page-sections.related-insights-block",
      "repeatable": false
    },
    "relatedGuidesBlock": {
      "type": "component",
      "component": "page-sections.related-guides-block",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  },
  "pluginOptions": {}
}
